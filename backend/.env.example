# Supabase Postgres connection string
# Get this from: Project Settings > Database > Connection string > URI
# Use "Session pooler" connection method (works over IPv4)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-here-min-32-chars

# Supabase Storage (same project as your database — no separate signup needed)
# SUPABASE_URL: Project Settings > General > Project URL (e.g. https://your-project.supabase.co)
# SUPABASE_SERVICE_ROLE_KEY: Project Settings > API Keys > service_role key (NOT the anon/public key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=mymusic

# Server
PORT=4000

# CORS — comma-separated list of allowed origins (e.g. https://your-app.com,https://dev.your-app.com)
# Use "true" to allow all origins (development only)
CORS_ORIGIN=true

# Logging
LOG_LEVEL=info

# Node environment
NODE_ENV=development